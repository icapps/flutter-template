#!/usr/bin/env bash
# Blocks a push of a ticket branch that has no finished .ai/pr-descriptions/<TICKET>.md.
# Checks the pushed commit, not the working tree, so the file must be committed.
# Bypass: PR_DESCRIPTION_SKIP=1 git push, or git push --no-verify.

[ "${PR_DESCRIPTION_SKIP:-}" = "1" ] && exit 0

ZERO=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_ref" in refs/heads/*) ;; *) continue ;; esac
  [ "$local_sha" = "$ZERO" ] && continue

  branch=${local_ref#refs/heads/}
  case "$branch" in master | main | develop | release/*) continue ;; esac

  ticket=$(printf '%s' "$branch" | grep -oE '[A-Z][A-Z0-9]+-[0-9]+' | head -n 1)
  if [ -z "$ticket" ]; then
    echo "pr-description: no ticket number in branch name '$branch'."
    echo "  Name the branch e.g. feat/ABC-123 (uppercase)."
    status=1
    continue
  fi

  path=".ai/pr-descriptions/${ticket}.md"
  if ! git cat-file -e "${local_sha}:${path}" 2>/dev/null; then
    echo "pr-description: ${path} is missing from the pushed commit of '$branch'."
    echo "  Generate it with the pr-description skill, complete it and commit it."
    status=1
    continue
  fi

  # HTML comments (the guidance from the template) are ignored.
  body=$(git show "${local_sha}:${path}" | perl -0pe 's/<!--.*?-->//gs')
  problems=""

  printf '%s\n' "$body" | grep -q 'TODO' &&
    problems="${problems}  - a TODO is still present\n"
  printf '%s\n' "$body" | grep -q 'Yes / No / Partial' &&
    problems="${problems}  - the evidence table in section 3 is not filled in\n"
  printf '%s\n' "$body" | grep -Eq '^## 1\. Risk: (S|M|L)([^A-Za-z]|$)' ||
    problems="${problems}  - section 1 has no risk size (S, M or L)\n"
  printf '%s\n' "$body" | grep -q '^## 2\. What changed and why' ||
    problems="${problems}  - section 2 \"What changed and why\" is missing\n"
  printf '%s\n' "$body" | grep -q '^## 3\. Evidence' ||
    problems="${problems}  - section 3 \"Evidence\" is missing\n"

  if [ -n "$problems" ]; then
    echo "pr-description: ${path} is not finished yet:"
    printf '%b' "$problems"
    status=1
  fi
done

exit $status
